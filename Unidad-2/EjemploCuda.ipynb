   "source": [
    "\n",
    "import torch\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    dispositivo = \"cuda\"\n",
    "else:\n",
    "    dispositivo = \"cpu\"\n",
    "\n",
    "a = torch.tensor([1, 2, 3], device=dispositivo)\n",
    "b = torch.tensor([4, 5, 6], device=dispositivo)\n",
    "\n",
    "resultado = a + b\n",
    "\n",
    "print(resultado)\n",
    "print(\"Dispositivo:\", dispositivo)\n"
   ]
  }
 ],
